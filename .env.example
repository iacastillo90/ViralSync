# ===================================================================== #
# VIRALSYNC ENVIRONMENT CONFIGURATION (.env.example)
# Copiar a .env y rellenar con tus API keys reales.
# ===================================================================== #

# Entorno de ejecución: dev | staging | production
AGENCY_ENV=dev

# --------------------------------------------------------------------- #
# Gateway LiteLLM Proxy
# --------------------------------------------------------------------- #
LITELLM_PROXY_URL=http://localhost:4000/v1
LITELLM_MASTER_KEY=sk-litellm-master-key-dev

# Modelo por defecto que usan los crews internamente (llama al proxy)
LITELLM_DEFAULT_MODEL=gemini/gemini-3.5-flash

# --------------------------------------------------------------------- #
# Pool Multi-LLM — Free Tiers (sin Ollama local requerido)
# Llenar las que tengas. LiteLLM hará fallback automático en 429.
# --------------------------------------------------------------------- #

# Google Gemini — 1M tokens/día gratis (Gemini 2.5 Flash)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — 14.4K tokens/min gratis (Llama 3.3-70B, Mixtral, etc.)
# https://console.groq.com/keys
GROQ_API_KEY=

# GitHub Models — free tier con token de GitHub Personal
# https://github.com/settings/tokens  (scope: no requerido)
GITHUB_MODELS_TOKEN=

# OpenRouter — acceso unificado, $1 USD de crédito inicial gratis
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Anthropic Claude — free tier con límite de mensajes
# https://console.anthropic.com/keys
ANTHROPIC_API_KEY=

# Together AI — $5 USD de crédito inicial gratis
# https://api.together.xyz
TOGETHER_API_KEY=

# Ollama local (OPCIONAL — si tenés GPU/CPU potente localmente)
OLLAMA_BASE_URL=http://localhost:11434

# --------------------------------------------------------------------- #
# Base de Datos & Caché / Cola
# --------------------------------------------------------------------- #
POSTGRES_USER=agency
POSTGRES_PASSWORD=agency
POSTGRES_DB=agency
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://agency:agency@localhost:5432/agency
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
SEARXNG_URL=http://localhost:8080

# --------------------------------------------------------------------- #
# Integraciones Meta / Instagram Graph API
# --------------------------------------------------------------------- #
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=token_verificacion_meta_dev
INSTAGRAM_APP_SECRET=secreto_meta_app_dev
GRAPH_API_VERSION=v19.0

# --------------------------------------------------------------------- #
# Almacenamiento MinIO / S3
# --------------------------------------------------------------------- #
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=viralsync-media

# Host alcanzable desde el BROWSER para las URLs presignadas de la galería
# (storage-honesty, REQ-SH-01-3). En docker-compose el backend usa
# MINIO_ENDPOINT=minio:9000 (host interno del contenedor, NO alcanzable desde
# el browser): seteá acá el host público si querés que los <img>/<video> de la
# galería carguen. Vacío por default → las URLs se firman contra MINIO_ENDPOINT.
# Ejemplo: MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=

# Fuerza TLS/HTTPS en el cliente (derivado automáticamente de https:// en
# MINIO_ENDPOINT si no se setea). Valores truthy: true | 1 | yes
MINIO_SECURE=false

# S3 externo (si usás AWS S3 en producción)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=viralsync-media-dev

# --------------------------------------------------------------------- #
# Búsqueda de Tendencias
# --------------------------------------------------------------------- #
PEXELS_API_KEY=

# --------------------------------------------------------------------- #
# Video Generation & Rendering Cloud APIs
# --------------------------------------------------------------------- #
# Proveedor del renderizado final de video: local | json2video
VIDEO_RENDERER_PROVIDER=local
JSON2VIDEO_API_KEY=

# --------------------------------------------------------------------- #
# Frontend Next.js (Variables accesibles en el cliente)
# --------------------------------------------------------------------- #
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SSE_URL=http://localhost:8000/realtime/sse
NEXT_PUBLIC_ENV=dev

