# ===================================================================== #
# VIRALSYNC ENVIRONMENT CONFIGURATION (.env.example)
# Copiar a .env y rellenar con tus API keys reales.
# ===================================================================== #

# Entorno de ejecución: dev | staging | production
AGENCY_ENV=dev

# --------------------------------------------------------------------- #
# Gateway LiteLLM Proxy
# --------------------------------------------------------------------- #
LITELLM_PROXY_URL=http://localhost:4000/v1
LITELLM_MASTER_KEY=sk-litellm-master-key-dev

# Modelo por defecto que usan los crews internamente (llama al proxy)
LITELLM_DEFAULT_MODEL=gemini/gemini-3.5-flash

# --------------------------------------------------------------------- #
# Pool Multi-LLM — Free Tiers (sin Ollama local requerido)
# Llenar las que tengas. LiteLLM hará fallback automático en 429.
# --------------------------------------------------------------------- #

# Google Gemini — 1M tokens/día gratis (Gemini 2.5 Flash)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — 14.4K tokens/min gratis (Llama 3.3-70B, Mixtral, etc.)
# https://console.groq.com/keys
GROQ_API_KEY=

# GitHub Models — free tier con token de GitHub Personal
# https://github.com/settings/tokens  (scope: no requerido)
GITHUB_MODELS_TOKEN=

# OpenRouter — acceso unificado, $1 USD de crédito inicial gratis
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --------------------------------------------------------------------- #
# Base de Datos & Caché / Cola
# --------------------------------------------------------------------- #
POSTGRES_USER=agency
POSTGRES_PASSWORD=agency
POSTGRES_DB=agency
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://agency:agency@localhost:5432/agency
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
SEARXNG_URL=http://localhost:8080

# --------------------------------------------------------------------- #
# Búsqueda de Tendencias y B-roll
# --------------------------------------------------------------------- #
PEXELS_API_KEY=

# --------------------------------------------------------------------- #
# Video Generation & Backgrounds (Generación de Fondos de Video con IA)
# --------------------------------------------------------------------- #
# Proveedor de clips de fondo por escena: google_labs | pollinations | pexels | fal_ai | shotstack | mock
# - google_labs: Google Veo / Imagen 3 (Vertex AI / Google AI Studio) para clips de 5s contextuales del producto
# - pollinations: Generación de fondo animado gratis (100% sin API key)
# - pexels: B-roll vertical real (9:16) gratis por palabra clave (usa PEXELS_API_KEY)
VIDEO_GEN_PROVIDER=google_labs

# API Key de Google AI Studio / Vertex AI (para Google Veo & Imagen 3 Video)
GOOGLE_AI_STUDIO_KEY=

# API Key de Fal.ai (para Wan2.1 / LTX-Video)
FAL_KEY=

# Proveedor del renderizado final de video: local | json2video
VIDEO_RENDERER_PROVIDER=json2video
JSON2VIDEO_API_KEY=

# --------------------------------------------------------------------- #
# Frontend Next.js (Variables accesibles en el cliente)
# --------------------------------------------------------------------- #
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SSE_URL=http://localhost:8000/realtime/sse
NEXT_PUBLIC_ENV=dev
